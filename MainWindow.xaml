<Window x:Class="Mobiphone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SC Hoàng Quốc"
        Icon="pack://application:,,,/icon.ico"
        Height="900"
        Width="1500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Two Column Layout for Filter and Import -->
        <Grid Grid.Row="0"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side - Filter Section (60%) -->
            <Border Grid.Column="0"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10"
                    Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="Phone:"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 x:Name="txtFilterPhone"
                                 Height="30"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2"
                                x:Name="btnClearFilter"
                                Content="Clear"
                                Width="80"
                                Height="30"
                                Click="BtnClearFilter_Click"
                                Background="#757575"
                                Foreground="White"
                                FontWeight="SemiBold"/>
                    </Grid>

                    <TextBlock Text="Loại sim:"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,15">
                        <CheckBox x:Name="chkFilterTuQuy"
                                  Content="Tứ quý"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterTaxi2"
                                  Content="Taxi 2"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterTaxi3"
                                  Content="Taxi 3"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterTaxi4"
                                  Content="Taxi 4"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterTaxi5"
                                  Content="Taxi 5"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterTaxiDu2"
                                  Content="Taxi dù 2"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterTaxiDu3"
                                  Content="Taxi dù 3"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterDuoiTien"
                                  Content="Đuôi tiến"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterSanhGiua"
                                  Content="Sảnh giữa"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterTamHoa"
                                  Content="Tam hoa"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterSoiGuong"
                                  Content="Soi gương"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterAXA_AYA"
                                  Content="AXA.AYA"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterAXA_BXB"
                                  Content="AXA.BXB"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterAXA_BYB"
                                  Content="AXA.BYB"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterABABAC"
                                  Content="ABABAC"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterABACAC"
                                  Content="ABACAC"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterXXXYYY"
                                  Content="XXXYYY"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterXXAYYA"
                                  Content="XXAYYA"
                                  ToolTip="Ví dụ: 009229"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterXAXBXC"
                                  Content="XAXBXC"
                                  ToolTip="Ví dụ: 171912"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterAXBXCX"
                                  Content="AXBXCX"
                                  ToolTip="Ví dụ: 698929"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterDuoiDacBiet"
                                  Content="Đuôi 39/43/79/68/52/99/86/89"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterTaxiDu3Tang1"
                                  Content="Taxi dù 3 tăng 1"
                                  ToolTip="Hai cụm 3 số chỉ khác một vị trí và vị trí sau tăng đúng 1"
                                  Margin="0,0,15,8"/>
                    </WrapPanel>

                    <TextBlock Text="HÀM LỌC BỔ SUNG"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Margin="0,0,0,10"/>
                    <CheckBox x:Name="chkExcludeBadSequences"
                              Content="Loại 4/49/53/74 ở mọi vị trí"
                              ToolTip="Điều kiện bổ sung, kết hợp AND với các loại sim đã chọn"
                              Margin="0,0,15,15"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnApplyFilter"
                                Grid.Column="0"
                                Content="🔍 Apply Filter"
                                Height="38"
                                Click="BtnApplyFilter_Click"
                                HorizontalAlignment="Stretch"
                                Background="#2196F3"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="14"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="btnExport"
                                Grid.Column="2"
                                Content="📥 Export Data"
                                Height="38"
                                Click="BtnExport_Click"
                                HorizontalAlignment="Stretch"
                                Background="#4CAF50"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="14"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Filter Status -->
                    <TextBlock x:Name="txtFilterStatus"
                               Text=""
                               FontStyle="Italic"
                               Foreground="#2196F3"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Right Side - Import Section (40%) -->
            <Border Grid.Column="2"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10"
                    Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="File Path:"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="txtFilePath"
                             Height="30"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"
                             Margin="0,0,0,10"/>

                    <Button x:Name="btnBrowse"
                            Grid.Column="0"
                            Content="📁 Browse File"
                            Height="35"
                            Click="BtnBrowse_Click"
                            Background="#2196F3"
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Margin="0,0,0,15"
                            FontSize="14">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="btnImport"
                            Content="▶ Import"
                            Height="35"
                            Click="BtnImport_Click"
                            IsEnabled="False"
                            Background="#4CAF50"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            Margin="0,0,0,15"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Opacity"
                                        Value="0.5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled"
                                             Value="True">
                                        <Setter Property="Opacity"
                                                Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Import Status and Progress -->
                    <TextBlock x:Name="txtStatus"
                               Text="Ready"
                               FontStyle="Italic"
                               Foreground="Gray"
                               Margin="0,0,0,8"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <ProgressBar x:Name="progressBar"
                                 Height="20"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Visibility="Collapsed"
                                 Margin="0,0,0,5"/>
                    <TextBlock x:Name="txtProgress"
                               Text=""
                               FontSize="11"
                               Foreground="#555"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Data Grid -->
        <DataGrid Grid.Row="1"
                  x:Name="dgData"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  AlternatingRowBackground="LightGray"
                  HeadersVisibility="All"
                  CanUserAddRows="False"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  BorderBrush="Gray"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  VirtualizingPanel.CacheLength="20"
                  VirtualizingPanel.CacheLengthUnit="Item"
                  HorizontalScrollBarVisibility="Auto"
                  PreviewKeyDown="DgData_PreviewKeyDown">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Phone"
                                    Binding="{Binding Phone}"
                                    Width="120"/>
                <DataGridCheckBoxColumn Header="Tứ quý"
                                        Binding="{Binding TuQuy}"
                                        Width="70"/>
                <DataGridCheckBoxColumn Header="Taxi 2"
                                        Binding="{Binding Taxi2}"
                                        Width="70"/>
                <DataGridCheckBoxColumn Header="Taxi 3"
                                        Binding="{Binding Taxi3}"
                                        Width="70"/>
                <DataGridCheckBoxColumn Header="Taxi 4"
                                        Binding="{Binding Taxi4}"
                                        Width="70"/>
                <DataGridCheckBoxColumn Header="Taxi 5"
                                        Binding="{Binding Taxi5}"
                                        Width="70"/>
                <DataGridCheckBoxColumn Header="Taxi dù 2"
                                        Binding="{Binding TaxiDu2}"
                                        Width="80"/>
                <DataGridCheckBoxColumn Header="Taxi dù 3"
                                        Binding="{Binding TaxiDu3}"
                                        Width="80"/>
                <DataGridCheckBoxColumn Header="Đuôi tiến"
                                        Binding="{Binding DuoiTien}"
                                        Width="80"/>
                <DataGridCheckBoxColumn Header="Sảnh giữa"
                                        Binding="{Binding SanhGiua}"
                                        Width="80"/>
                <DataGridCheckBoxColumn Header="Tam hoa"
                                        Binding="{Binding TamHoa}"
                                        Width="80"/>
                <DataGridCheckBoxColumn Header="Soi gương"
                                        Binding="{Binding SoiGuong}"
                                        Width="85"/>
                <DataGridCheckBoxColumn Header="AXA.AYA"
                                        Binding="{Binding AXA_AYA}"
                                        Width="85"/>
                <DataGridCheckBoxColumn Header="AXA.BXB"
                                        Binding="{Binding AXA_BXB}"
                                        Width="85"/>
                <DataGridCheckBoxColumn Header="AXA.BYB"
                                        Binding="{Binding AXA_BYB}"
                                        Width="85"/>
                <DataGridCheckBoxColumn Header="ABABAC"
                                        Binding="{Binding ABABAC}"
                                        Width="80"/>
                <DataGridCheckBoxColumn Header="ABACAC"
                                        Binding="{Binding ABACAC}"
                                        Width="80"/>
                <DataGridCheckBoxColumn Header="XXXYYY"
                                        Binding="{Binding XXXYYY}"
                                        Width="80"/>
                <DataGridCheckBoxColumn Header="XXAYYA"
                                        Binding="{Binding XXAYYA}"
                                        Width="80"/>
                <DataGridCheckBoxColumn Header="XAXBXC"
                                        Binding="{Binding XAXBXC}"
                                        Width="80"/>
                <DataGridCheckBoxColumn Header="AXBXCX"
                                        Binding="{Binding AXBXCX}"
                                        Width="80"/>
                <DataGridCheckBoxColumn Header="Đuôi đặc biệt"
                                        Binding="{Binding DuoiDacBiet}"
                                        Width="105"/>
                <DataGridCheckBoxColumn Header="Taxi dù 3 tăng 1"
                                        Binding="{Binding TaxiDu3Tang1}"
                                        Width="115"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Statistics and Pagination -->
        <Grid Grid.Row="2"
              Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Statistics -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal">
                <TextBlock Text="Total Records: "
                           FontWeight="Bold"/>
                <TextBlock x:Name="txtRecordCount"
                           Text="0"
                           Margin="0,0,20,0"/>
                <TextBlock Text="Database: "
                           FontWeight="Bold"/>
                <TextBlock x:Name="txtDatabasePath"
                           Text="records.db"
                           Margin="0,0,20,0"/>
            </StackPanel>

            <!-- Pagination Controls -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock Text="Page Size: "
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <ComboBox x:Name="cmbPageSize"
                          Width="80"
                          SelectedIndex="1"
                          SelectionChanged="CmbPageSize_SelectionChanged">
                    <ComboBoxItem Content="50"/>
                    <ComboBoxItem Content="100"/>
                    <ComboBoxItem Content="500"/>
                    <ComboBoxItem Content="1000"/>
                </ComboBox>
                <Button x:Name="btnFirstPage"
                        Content="« First"
                        Width="60"
                        Height="25"
                        Click="BtnFirstPage_Click"
                        Margin="10,0,5,0"
                        IsEnabled="False"/>
                <Button x:Name="btnPrevPage"
                        Content="‹ Prev"
                        Width="60"
                        Height="25"
                        Click="BtnPrevPage_Click"
                        Margin="0,0,5,0"
                        IsEnabled="False"/>
                <TextBlock x:Name="txtPageInfo"
                           Text="Page 1 of 1"
                           VerticalAlignment="Center"
                           Margin="5,0,5,0"
                           MinWidth="80"
                           TextAlignment="Center"/>
                <Button x:Name="btnNextPage"
                        Content="Next ›"
                        Width="60"
                        Height="25"
                        Click="BtnNextPage_Click"
                        Margin="0,0,5,0"
                        IsEnabled="False"/>
                <Button x:Name="btnLastPage"
                        Content="Last »"
                        Width="60"
                        Height="25"
                        Click="BtnLastPage_Click"
                        Margin="0,0,0,0"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
