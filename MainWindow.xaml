<Window x:Class="Mobiphone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Mobiphone - SIM Manager"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Two Column Layout for Filter and Import -->
        <Grid Grid.Row="0"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side - Filter Section (60%) -->
            <Border Grid.Column="0"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15"
                    Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="Phone:"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 x:Name="txtFilterPhone"
                                 Height="30"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2"
                                x:Name="btnClearFilter"
                                Content="Clear"
                                Width="80"
                                Height="30"
                                Click="BtnClearFilter_Click"
                                Background="#757575"
                                Foreground="White"
                                FontWeight="SemiBold"/>
                    </Grid>

                    <TextBlock Text="Loại sim:"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,15">
                        <CheckBox x:Name="chkFilterMiniThanTai"
                                  Content="MINI thần tài"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterBigThanTai"
                                  Content="BIG Thần tài"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterLocPhat"
                                  Content="Lộc phát"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterTuQuy"
                                  Content="Tứ quý"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterTuQuyGiua"
                                  Content="Tứ quý giữa"
                                  Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkFilterTamHoaKep"
                                  Content="Tam hoa kép"
                                  Margin="0,0,0,8"/>
                    </WrapPanel>

                    <Button x:Name="btnApplyFilter"
                            Content="🔍 Apply Filter"
                            Height="35"
                            Click="BtnApplyFilter_Click"
                            HorizontalAlignment="Stretch"
                            Background="#FF9800"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            Margin="0,0,0,15"/>

                    <!-- Filter Status -->
                    <TextBlock x:Name="txtFilterStatus"
                               Text=""
                               FontStyle="Italic"
                               Foreground="#2196F3"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Right Side - Import Section (40%) -->
            <Border Grid.Column="2"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15"
                    Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="File/Folder Path:"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="txtFilePath"
                             Height="30"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"
                             Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnBrowse"
                                Grid.Column="0"
                                Content="📁 Browse File"
                                Height="35"
                                Click="BtnBrowse_Click"
                                Background="#2196F3"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="14">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="btnBrowseFolder"
                                Grid.Column="2"
                                Content="📂 Browse Folder"
                                Height="35"
                                Click="BtnBrowseFolder_Click"
                                Background="#9C27B0"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="14">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Button x:Name="btnImport"
                            Content="▶ Import"
                            Height="35"
                            Click="BtnImport_Click"
                            IsEnabled="False"
                            Background="#4CAF50"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            Margin="0,0,0,15">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Opacity"
                                        Value="0.5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled"
                                             Value="True">
                                        <Setter Property="Opacity"
                                                Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Import Status and Progress -->
                    <TextBlock x:Name="txtStatus"
                               Text="Ready"
                               FontStyle="Italic"
                               Foreground="Gray"
                               Margin="0,0,0,8"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <ProgressBar x:Name="progressBar"
                                 Height="20"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Visibility="Collapsed"
                                 Margin="0,0,0,5"/>
                    <TextBlock x:Name="txtProgress"
                               Text=""
                               FontSize="11"
                               Foreground="#555"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Data Grid -->
        <DataGrid Grid.Row="1"
                  x:Name="dgData"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  AlternatingRowBackground="LightGray"
                  HeadersVisibility="All"
                  CanUserAddRows="False"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  BorderBrush="Gray"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  VirtualizingPanel.CacheLength="20"
                  VirtualizingPanel.CacheLengthUnit="Item"
                  PreviewKeyDown="DgData_PreviewKeyDown">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Phone"
                                    Binding="{Binding Phone}"
                                    Width="100"/>
                <DataGridCheckBoxColumn Header="MINI thần tài"
                                        Binding="{Binding MiniThanTai}"
                                        Width="100"/>
                <DataGridCheckBoxColumn Header="BIG Thần tài"
                                        Binding="{Binding BigThanTai}"
                                        Width="100"/>
                <DataGridCheckBoxColumn Header="Lộc phát"
                                        Binding="{Binding LocPhat}"
                                        Width="80"/>
                <DataGridCheckBoxColumn Header="Tứ quý"
                                        Binding="{Binding TuQuy}"
                                        Width="70"/>
                <DataGridCheckBoxColumn Header="Tứ quý giữa"
                                        Binding="{Binding TuQuyGiua}"
                                        Width="100"/>
                <DataGridCheckBoxColumn Header="Tam hoa kép"
                                        Binding="{Binding TamHoaKep}"
                                        Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Statistics and Pagination -->
        <Grid Grid.Row="2"
              Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Statistics -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal">
                <TextBlock Text="Total Records: "
                           FontWeight="Bold"/>
                <TextBlock x:Name="txtRecordCount"
                           Text="0"
                           Margin="0,0,20,0"/>
                <TextBlock Text="Database: "
                           FontWeight="Bold"/>
                <TextBlock x:Name="txtDatabasePath"
                           Text="records.db"
                           Margin="0,0,20,0"/>
            </StackPanel>

            <!-- Pagination Controls -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock Text="Page Size: "
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <ComboBox x:Name="cmbPageSize"
                          Width="80"
                          SelectedIndex="1"
                          SelectionChanged="CmbPageSize_SelectionChanged">
                    <ComboBoxItem Content="50"/>
                    <ComboBoxItem Content="100"/>
                    <ComboBoxItem Content="500"/>
                    <ComboBoxItem Content="1000"/>
                </ComboBox>
                <Button x:Name="btnFirstPage"
                        Content="« First"
                        Width="60"
                        Height="25"
                        Click="BtnFirstPage_Click"
                        Margin="10,0,5,0"
                        IsEnabled="False"/>
                <Button x:Name="btnPrevPage"
                        Content="‹ Prev"
                        Width="60"
                        Height="25"
                        Click="BtnPrevPage_Click"
                        Margin="0,0,5,0"
                        IsEnabled="False"/>
                <TextBlock x:Name="txtPageInfo"
                           Text="Page 1 of 1"
                           VerticalAlignment="Center"
                           Margin="5,0,5,0"
                           MinWidth="80"
                           TextAlignment="Center"/>
                <Button x:Name="btnNextPage"
                        Content="Next ›"
                        Width="60"
                        Height="25"
                        Click="BtnNextPage_Click"
                        Margin="0,0,5,0"
                        IsEnabled="False"/>
                <Button x:Name="btnLastPage"
                        Content="Last »"
                        Width="60"
                        Height="25"
                        Click="BtnLastPage_Click"
                        Margin="0,0,0,0"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
