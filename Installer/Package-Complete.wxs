<?xml version="1.0" encoding="UTF-8"?>
<!--
  Simplified WiX Package that includes all files from publish directory
  Compatible with WiX Toolset 4.x
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="SC Hoang Quoc" 
           Manufacturer="SC Hoang Quoc" 
           Version="1.0.0.0"
           UpgradeCode="448B8468-32D0-4EF8-90AA-BF5DD8C1AA75">
    
    <MajorUpgrade DowngradeErrorMessage="Đã cài đặt phiên bản mới hơn của [ProductName]." />
    
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Feature Id="ProductFeature" Title="SC Hoang Quoc Application" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ApplicationShortcutStartMenu" />
      <ComponentRef Id="ApplicationShortcutDesktop" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SC Hoang Quoc" />
    </StandardDirectory>
    
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="SC Hoang Quoc" />
    </StandardDirectory>
    
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <!-- Main application files -->
    <Component Id="MainExecutable" Directory="INSTALLFOLDER">
      <!-- Main EXE -->
      <File Id="SCHoangQuocExe" 
            Source="..\bin\Release\net8.0-windows\win-x64\publish\SC Hoang Quoc.exe" 
            KeyPath="yes" />
      
      <!-- DLL files -->
      <File Id="SCHoangQuocDll" 
            Source="..\bin\Release\net8.0-windows\win-x64\publish\SC Hoang Quoc.dll" />
      
      <!-- EPPlus dependencies -->
      <File Id="EPPlusDll" 
            Source="..\bin\Release\net8.0-windows\win-x64\publish\EPPlus.dll" />
      <File Id="EPPlusInterfacesDll" 
            Source="..\bin\Release\net8.0-windows\win-x64\publish\EPPlus.Interfaces.dll" />
      <File Id="EPPlusSystemDrawingDll" 
            Source="..\bin\Release\net8.0-windows\win-x64\publish\EPPlus.System.Drawing.dll" />
      
      <!-- SQLite dependencies -->
      <File Id="SQLiteCoreDll" 
            Source="..\bin\Release\net8.0-windows\win-x64\publish\System.Data.SQLite.dll" />
      
      <!-- SQLite native libraries -->
      <File Id="SQLiteInteropDll" 
            Source="..\bin\Release\net8.0-windows\win-x64\publish\SQLite.Interop.dll" />
      
      <!-- System dependencies -->
      <File Id="SystemIOCompressionDll" 
            Source="..\bin\Release\net8.0-windows\win-x64\publish\System.IO.Compression.dll" />
      <File Id="SystemSecurityCryptographyDll" 
            Source="..\bin\Release\net8.0-windows\win-x64\publish\System.Security.Cryptography.Pkcs.dll" />
      <File Id="SystemSecurityCryptographyXmlDll" 
            Source="..\bin\Release\net8.0-windows\win-x64\publish\System.Security.Cryptography.Xml.dll" />
      
      <!-- Microsoft dependencies -->
      <File Id="MicrosoftWin32SystemEventsDll" 
            Source="..\bin\Release\net8.0-windows\win-x64\publish\Microsoft.Win32.SystemEvents.dll" />
      <File Id="SystemDrawingCommonDll" 
            Source="..\bin\Release\net8.0-windows\win-x64\publish\System.Drawing.Common.dll" />
      
      <!-- Configuration files -->
      <File Id="SCHoangQuocRuntimeConfig" 
            Source="..\bin\Release\net8.0-windows\win-x64\publish\SC Hoang Quoc.runtimeconfig.json" />
      <File Id="SCHoangQuocDepsJson" 
            Source="..\bin\Release\net8.0-windows\win-x64\publish\SC Hoang Quoc.deps.json" />
      
      <!-- PDB for debugging (optional) -->
      <File Id="SCHoangQuocPdb" 
            Source="..\bin\Release\net8.0-windows\win-x64\publish\SC Hoang Quoc.pdb" />
    </Component>

    <!-- Start Menu Shortcut -->
    <Component Id="ApplicationShortcutStartMenu" Directory="ApplicationProgramsFolder">
      <Shortcut Id="StartMenuShortcut"
                Name="SC Hoang Quoc"
                Description="Chuyển đổi Excel sang SQLite"
                Target="[INSTALLFOLDER]SC Hoang Quoc.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon"
                IconIndex="0" />
      <RemoveFolder Id="CleanUpStartMenu" On="uninstall" />
      <RegistryValue Root="HKCU" 
                     Key="Software\SC Hoang Quoc" 
                     Name="StartMenuShortcut" 
                     Type="integer" 
                     Value="1" 
                     KeyPath="yes" />
    </Component>

    <!-- Desktop Shortcut -->
    <Component Id="ApplicationShortcutDesktop" Directory="DesktopFolder">
      <Shortcut Id="DesktopShortcut"
                Name="SC Hoang Quoc"
                Description="Chuyển đổi Excel sang SQLite"
                Target="[INSTALLFOLDER]SC Hoang Quoc.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon"
                IconIndex="0" />
      <RegistryValue Root="HKCU" 
                     Key="Software\SC Hoang Quoc" 
                     Name="DesktopShortcut" 
                     Type="integer" 
                     Value="1" 
                     KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Icon Id="AppIcon" SourceFile="..\icon.ico" />
  </Fragment>
</Wix>