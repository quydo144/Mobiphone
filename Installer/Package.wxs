<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Mobiphone" 
           Manufacturer="Mobiphone" 
           Version="1.0.0.0"
           UpgradeCode="12345678-1234-1234-1234-123456789012">
    
    <MajorUpgrade DowngradeErrorMessage="Đã cài đặt phiên bản mới hơn của [ProductName]." />
    
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" /> 
    <Feature Id="ProductFeature" Title="Mobiphone Application" Level="1">
      <!-- HarvestedFiles will be generated by heat.exe -->
      <ComponentGroupRef Id="HarvestedFiles" />
      <ComponentRef Id="ApplicationShortcutStartMenu" />
      <ComponentRef Id="ApplicationShortcutDesktop" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Mobiphone" />
    </StandardDirectory>
    
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Mobiphone" />
    </StandardDirectory>
    
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <!-- Start Menu Shortcut -->
    <Component Id="ApplicationShortcutStartMenu" Directory="ApplicationProgramsFolder">
      <Shortcut Id="StartMenuShortcut"
                Name="Mobiphone"
                Description="Chuyển đổi Excel sang SQLite"
                Target="[INSTALLFOLDER]Mobiphone.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon"
                IconIndex="0" />
      <RemoveFolder Id="CleanUpStartMenu" On="uninstall" />
      <RegistryValue Root="HKCU" 
                     Key="Software\Mobiphone" 
                     Name="StartMenuShortcut" 
                     Type="integer" 
                     Value="1" 
                     KeyPath="yes" />
    </Component>

    <!-- Desktop Shortcut -->
    <Component Id="ApplicationShortcutDesktop" Directory="DesktopFolder">
      <Shortcut Id="DesktopShortcut"
                Name="Mobiphone"
                Description="Chuyển đổi Excel sang SQLite"
                Target="[INSTALLFOLDER]Mobiphone.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon"
                IconIndex="0" />
      <RegistryValue Root="HKCU" 
                     Key="Software\Mobiphone" 
                     Name="DesktopShortcut" 
                     Type="integer" 
                     Value="1" 
                     KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Icon Id="AppIcon" SourceFile="icon.ico" />
  </Fragment>
</Wix>